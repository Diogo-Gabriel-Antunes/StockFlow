# =========================================================
# StockFlow - Oracle Cloud Always Free production by public IP
# Copy to .env.production and replace IP_DA_VPS and secrets.
# =========================================================

APP_NAME=StockFlow
APP_ENV=production
VPS_PUBLIC_IP=IP_DA_VPS

# Public URLs without domain/HTTPS for this phase
APP_URL=http://IP_DA_VPS
API_URL=http://IP_DA_VPS/api
PUBLIC_APP_URL=http://IP_DA_VPS

# Next.js build-time public variables
NEXT_PUBLIC_APP_NAME=StockFlow
NEXT_PUBLIC_API_URL=http://IP_DA_VPS/api
NEXT_PUBLIC_PUBLIC_APP_URL=http://IP_DA_VPS

# Backend / Quarkus
QUARKUS_HTTP_PORT=8080
QUARKUS_PROFILE=prod

# JWT - replace with a long random value before deploy
JWT_SECRET=replace-with-a-long-random-production-secret
JWT_ISSUER=stockflow
JWT_EXPIRES_IN=3600

# CORS must match the public IP URL used by the browser
CORS_ORIGINS=http://IP_DA_VPS

# PostgreSQL - do not expose publicly
POSTGRES_DB=stockflow
POSTGRES_USER=stockflow
POSTGRES_PASSWORD=replace-with-a-strong-database-password

DB_USERNAME=stockflow
DB_PASSWORD=replace-with-a-strong-database-password
DB_JDBC_URL=jdbc:postgresql://postgres:5432/stockflow

# Public quote links generated by backend
PUBLIC_QUOTE_BASE_URL=http://IP_DA_VPS/public/quotes
PDF_STORAGE_MODE=local
STORAGE_LOCAL_PATH=/app/storage

# Backup
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7

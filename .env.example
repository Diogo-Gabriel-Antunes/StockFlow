# =========================================================
# StockFlow - Environment Example
# Copy this file to .env and adjust values.
# =========================================================

# ---------------------------------------------------------
# General
# ---------------------------------------------------------
APP_NAME=StockFlow
APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8080
PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------
# Frontend / Next.js
# ---------------------------------------------------------
NEXT_PUBLIC_APP_NAME=StockFlow
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------
# Backend / Quarkus
# ---------------------------------------------------------
QUARKUS_HTTP_PORT=8080
QUARKUS_PROFILE=dev

# JWT
JWT_SECRET=change-this-secret-in-production
JWT_ISSUER=stockflow
JWT_EXPIRES_IN=3600

# CORS
CORS_ORIGINS=http://localhost:3000

# Default development owner user created by Flyway seed
DEFAULT_OWNER_EMAIL=admin@stockflow.local
DEFAULT_OWNER_PASSWORD=Admin123!

# ---------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------
POSTGRES_DB=stockflow
POSTGRES_USER=stockflow
POSTGRES_PASSWORD=stockflow_dev_password
POSTGRES_PORT=5432

DB_HOST=postgres
DB_PORT=5432
DB_NAME=stockflow
DB_USERNAME=stockflow
DB_PASSWORD=stockflow_dev_password
DB_JDBC_URL=jdbc:postgresql://postgres:5432/stockflow

# ---------------------------------------------------------
# PDF / Public Quote
# ---------------------------------------------------------
PUBLIC_QUOTE_BASE_URL=http://localhost:3000/public/quotes
PDF_STORAGE_MODE=local

# ---------------------------------------------------------
# Storage - optional for future
# ---------------------------------------------------------
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=/app/storage

# S3/R2 future usage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# ---------------------------------------------------------
# Email - optional for future
# ---------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@stockflow.local

# ---------------------------------------------------------
# SaaS Billing - future
# ---------------------------------------------------------
BILLING_PROVIDER=none
ASAAS_API_KEY=
MERCADOPAGO_ACCESS_TOKEN=

# ---------------------------------------------------------
# Production domains - future
# ---------------------------------------------------------
PRODUCTION_APP_DOMAIN=app.seudominio.com.br
PRODUCTION_API_DOMAIN=api.seudominio.com.br

# ---------------------------------------------------------
# Backup
# ---------------------------------------------------------
BACKUP_ENABLED=false
BACKUP_RETENTION_DAYS=7
